def words_of(cfg, file, case):
    """The word outcomes of `case` in the stored run `file` (following a
    reused case to the run that ran it): {(text, word): (kind, typed, target, got)}."""
    path = os.path.join(results_dir(cfg), file)
    with open(path) as f:
        rec = json.load(f)
    if case in rec.get("reused", {}) and rec["reused"][case] != file:
        return words_of(cfg, rec["reused"][case], case)
    tsv = os.path.join(results_dir(cfg), file[:-5] + ".words", case + ".tsv.gz")
    if not os.path.exists(tsv):
        return None
    out = {}
    with gzip.open(tsv, "rt", encoding="utf-8") as f:
        for line in f:
            t, w, kind, typed, target, got = line.rstrip("\n").split("\t")
            out[(int(t), int(w))] = (kind, typed, target, got)
    return out


def outcome(entry):
    """fixed, wrong or left (a typo or misspelling); kept or changed (a
    correct or unknown word); a word missing from the outcomes is kept."""
    if entry is None:
        return "kept"
    kind, typed, target, got = entry
    if kind in ("clean", "unknown word"):
        return "kept" if got.lower() == target.lower() else "changed"
    if got.lower() == target.lower():
        return "fixed"
    return "left" if got == typed else "wrong"


def cmd_diff(args, cfg):
    """The words whose outcome differs between two runs, per case."""
    from collections import Counter, defaultdict
    runs = stored_runs(cfg)
    def pick(key):
        for file, rec in reversed(runs):
            if key in (rec["label"], file, file[:-5]):
                return file, rec
        sys.exit(f"pf: no stored run {key!r} (pf runs lists them)")
    (fa, ra), (fb, rb) = pick(args.a), pick(args.b)
    cases = sorted(c for c in set(ra["cases"]) & set(rb["cases"]) if re.search(args.cases, c))
    totals = Counter()
    for case in cases:
        wa, wb = words_of(cfg, fa, case), words_of(cfg, fb, case)
        if wa is None or wb is None:
            continue   # not a sentence-bench case, or a run from before pf diff
        moves, typed_differs = defaultdict(list), 0
        for key in sorted(set(wa) | set(wb)):
            a, b = wa.get(key), wb.get(key)
            if a and b and a[:3] != b[:3]:
                typed_differs += 1   # other typos drawn (the runs differ in more than the decision)
                continue
            oa, ob = outcome(a), outcome(b)
            if oa != ob:
                moves[(oa, ob)].append(a or b)
        if not moves and not typed_differs:
            continue
        got = {}   # (typed, target): what each run gave (first seen)
        for key in sorted(set(wa) | set(wb)):
            a, b = wa.get(key), wb.get(key)
            e = a or b
            got.setdefault((e[1], e[2]), (a[3] if a else e[1], b[3] if b else e[1]))
        n = sum(len(v) for v in moves.values())
        print(f"\n== {case}: {n} words changed outcome" + (f" ({typed_differs} typed differently, left out)" if typed_differs else ""))
        for (oa, ob), entries in sorted(moves.items(), key=lambda m: -len(m[1])):
            totals[(oa, ob)] += len(entries)
            by_word = Counter((e[1], e[2]) for e in entries)
            shown = []
            for (typed, target), k in by_word.most_common(args.top):
                ga, gb = got[(typed, target)]
                shown.append(f"{typed} ({target}: {ga} / {gb})" + (f" x{k}" if k > 1 else ""))
            print(f"  {oa + ' → ' + ob:18} {len(entries):5}  " + ", ".join(shown))
    if totals:
        print("\nall cases: " + ", ".join(f"{a} → {b} {n}" for (a, b), n in totals.most_common()))
    else:
        print("no word changed outcome (or no word outcomes stored: runs from pf suite since bench-tools)")
    return 0


def score_of(record, expr):
    """A run's score: `expr` over the metrics averaged over the cases that
    have them (e.g. -wer_after, fixed-4*wrong)."""
    sums, counts = {}, {}
    for m in record["cases"].values():
        for k, v in m.items():
            if k != "error":
                sums[k] = sums.get(k, 0) + v
                counts[k] = counts.get(k, 0) + 1
    means = {k: sums[k] / counts[k] for k in sums}
    names = set(re.findall(r"[A-Za-z_]\w*", expr))
    return eval(expr, {"__builtins__": {}}, {k: means.get(k, 0.0) for k in names})


def is_decision_param(build_dir, assignment):
    """Whether the engine can replay `assignment` (isDecisionParam): the
    bench refuses -Y otherwise."""
    out = run([f"{build_dir}/tests/sentence-bench", "-l", PHONE_LAYOUT, "-t", "tests/data/apostrophes.txt",
               "-d", f"{build_dir}/data/en.pfd", "-E", "-Y", assignment], capture_output=True, text=True)
    return out.returncode == 0


def cmd_sweep(args, cfg):
    """Two stages: every value on the first --quick texts of each case,
    then the whole suite for the --best few; decision parameters replayed
    on one search (sentence-bench -Y), others run one by one."""
    build(args.build)
    values = args.values.split()
    settings = [f"{args.name}={v}" for v in values]
    replay = all(is_decision_param(args.build, s) for s in settings)
    label = args.label or f"sweep-{args.name}"

    def stage(texts, chosen, suffix):
        ns = argparse.Namespace(build=args.build, param=args.param, only=args.only, jobs=args.jobs, all=False,
                                no_shard=False, texts=texts, label=None, replay=chosen if replay else None)
        _, base = run_suite(ns, cfg, label=label + suffix)
        scores = {"(base)": score_of(base, args.score)}
        if replay:
            for s in chosen:
                rec = find_run(stored_runs(cfg), f"{label + suffix}[{s}]")
                scores[s] = score_of(rec, args.score)
        else:
            for s in chosen:
                ns.param = (args.param or []) + [s]
                _, rec = run_suite(ns, cfg, label=f"{label + suffix}[{s}]")
                scores[s] = score_of(rec, args.score)
        return scores

    # Replayed values cost little more than one run: all on the whole
    # suite, unless --quick asks for the first stage anyway.
    quick_texts = args.quick if args.quick is not None else (0 if replay else 300)
    quick = stage(quick_texts, settings, "-quick") if quick_texts else None
    ranked = sorted(settings, key=lambda s: -quick[s]) if quick else settings
    best = ranked[:args.best] if quick else settings
    full = stage(None, best, "")
    if not quick:
        ranked = sorted(settings, key=lambda s: -full[s])
        quick = {}
    print(f"\nsweep {args.name} ({'replayed' if replay else 'one run each'}), score {args.score}:")
    print(f"{'setting':32} {'quick':>10} {'full':>10}")
    for s in ["(base)"] + ranked:
        q = f"{quick[s]:10.3f}" if s in quick else f"{'-':>10}"
        print(f"{s:32} {q} {full[s]:10.3f}" if s in full else f"{s:32} {q} {'-':>10}")
    top = max(best, key=lambda s: full[s])
    print(f"then: tools/pf compare {label} '{label}[{top}]'; tools/pf diff {label} '{label}[{top}]'")
    return 0


def cmd_table(args, cfg):
    """One line per language: the main numbers of a stored run."""
    runs = stored_runs(cfg)
    if not runs:
        sys.exit("pf: no stored runs (pf suite)")
    rec = find_run(runs, args.label) if args.label else runs[-1][1]
    cases = rec["cases"]
    get = lambda case, metric: cases.get(case, {}).get(metric)
    cols = [("typos fixed", lambda l: get(f"typos-{l}", "fixed")),
            ("wrong", lambda l: get(f"typos-{l}", "wrong")),
            ("WER after", lambda l: get(f"typos-{l}", "wer_after")),
            ("unknown chg", lambda l: get(f"typos-{l}", "unknown_changed")),
            ("mixed chg", lambda l: max((m.get("correct_changed", 0) for c, m in cases.items()
                                         if c.startswith("mixed-") and l in c.split("-")[2:]), default=None)),
            ("missp fixed", lambda l: get(f"missp-{l}", "missp_fixed")),
            ("missp wrong", lambda l: get(f"missp-{l}", "missp_wrong")),
            ("KSR tatoeba", lambda l: get(f"nextword-tatoeba-{l}", "ksr")),
            ("KSR sentences", lambda l: get(f"nextword-sentences-{l}", "ksr"))]
    print(f"{rec['label']} ({rec['commit']}{', dirty' if rec['dirty'] else ''}); mixed chg: the most of its mixed-* cases")
    print(f"{'lang':6}" + "".join(f"{name:>14}" for name, _ in cols))
    for lang in LANGUAGES:
        vals = [f(lang) for _, f in cols]
        print(f"{lang:6}" + "".join(f"{'-' if v is None else f'{v:.2f}':>14}" for v in vals))
    return 0


# --- failures by cause -------------------------------------------------------

CAUSES = [
    ("a-missing", "target in no loaded dictionary"),
    ("b-not-reached", "target not among the candidates"),
    ("c-commoner", "a commoner word ranks first"),
    ("d-unknown", "target first, the unknown-word hypothesis the main rival"),
    ("e-rule", "target first, a rule kept it out"),
    ("f-other", "another word ranks first (taps, context)"),
]


def classify(e):
    """The cause of one failure of the -C dump (a typo or misspelling not
    fixed, or fixed to another word): (cause, detail)."""
    if e["target_lp"] is None:
        return "a-missing", ""
    if e["target_rank"] < 0:
        return "b-not-reached", ""
    complete = [c for c in e["cands"] if not c[4]]
    first = complete[0] if complete else None
    target = e["target"].lower()
    if first is None or first[0].lower() != target:
        if e["capital"] and e["target"][:1].islower():
            return "e-rule", "capital"
        if first is not None and first[2] is not None and first[2] > e["target_lp"]:
            return "c-commoner", first[0]
        return "f-other", first[0] if first else ""
    reason = e["reason"]
    if reason == "applied" and e["typed"][:1].isdigit():
        return "e-rule", "leading digit (handler)"
    if reason.startswith("below-"):
        rest = 1 - e["conf"] - e["unknown"]
        if e["unknown"] >= e["conf"] or e["unknown"] >= rest:
            return "d-unknown", reason
        return "e-rule", reason
    if reason in ("applied", "case-fix"):
        return "f-other", reason
    return "e-rule", reason


def failures_of(path):
    """The fixable typos and misspellings of a dump that were not fixed,
    and the correct or unknown words that were changed."""
    fails, changed, fixable = [], [], 0
    with open(path, encoding="utf-8") as f:
        for line in f:
            e = json.loads(line)
            kind = e["kind"]
            if kind in ("clean", "unknown word"):
                if e["got"].lower() != e["target"].lower():
                    changed.append(e)
                continue
            if e["valid"] or kind == "real word":
                continue   # typed a word of some language: not counted as fixable
            fixable += 1
            if not (e["fired"] and e["got"].lower() == e["target"].lower()):
                fails.append(e)
    return fixable, fails, changed


def print_failures(case, fixable, fails, changed, top):
    from collections import Counter, defaultdict
    wrong = sum(1 for e in fails if e["fired"])
    print(f"\n== {case}: {fixable} fixable, {len(fails)} failed ({len(fails) - wrong} left, {wrong} fixed wrong)")
    by = defaultdict(list)
    for e in fails:
        cause, detail = classify(e)
        by[cause].append((e, detail))
    summary = {}
    for cause, what in CAUSES:
        items = by.get(cause, [])
        summary[cause] = len(items)
        if not items:
            continue
        print(f"  {cause:14} {len(items):5} {100.0 * len(items) / max(1, len(fails)):5.1f}%  {what}")
        details = Counter(d for _, d in items if d)
        if cause in ("d-unknown", "e-rule") and details:
            print("      " + ", ".join(f"{d} {n}" for d, n in details.most_common(8)))
        words = Counter(e["target"].lower() for e, _ in items)
        # An example each: typed→what it became, or typed: the word first.
        example = {}
        for e, d in items:
            example.setdefault(e["target"].lower(), e["typed"] + (
                "→" + e["got"] if e["fired"] else ": " + d + " first" if cause in ("c-commoner", "f-other") and d else ""))
        shown = [f"{w} {n} ({example[w]})" for w, n in words.most_common(top)]
        print("      " + ", ".join(shown))
    if changed:
        words = Counter((e["typed"], e["got"]) for e in changed)
        print(f"  changed (correct or unknown words): {len(changed)}; "
              + ", ".join(f"{t}→{g} {n}" for (t, g), n in words.most_common(top)))
    return summary


def cmd_failures(args, cfg):
    params = list(args.param or [])
    if args.run:
        rec = find_run(stored_runs(cfg), args.run)
        params = rec.get("params", []) + params
        if rec["commit"] != git("rev-parse", "--short", "HEAD") or rec["dirty"]:
            print(f"pf failures: {args.run} was run at {rec['commit']}{' (dirty)' if rec['dirty'] else ''}; "
                  f"this is HEAD {git('rev-parse', '--short', 'HEAD')}: the numbers may differ", file=sys.stderr)
    build(args.build)
    out_dir = os.path.join(REPO, args.build, "failures")
    os.makedirs(out_dir, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        cases = [c for c in suite_cases(args.build, cfg, tmp)
                 if c[1][0].endswith("sentence-bench") and re.search(args.cases, c[0])]
        if not cases:
            sys.exit(f"pf failures: no sentence-bench case matches {args.cases!r}")
        extra = sum((["-P", p] for p in params), [])
        jobs = [(n, cmd + extra + ["-C", os.path.join(out_dir, n + ".jsonl")] + (["-G"] if args.all_words else []), keep)
                for n, cmd, keep in cases]
        with concurrent.futures.ThreadPoolExecutor(args.jobs) as pool:
            done = list(pool.map(run_case, jobs))
    for n, m, _ in done:
        if "error" in m:
            print(f"pf: {n} failed: {m['error']}", file=sys.stderr)
    table = {}
    for n, _, _ in sorted(done):
        path = os.path.join(out_dir, n + ".jsonl")
        if os.path.exists(path):
            fixable, fails, changed = failures_of(path)
            table[n] = (fixable, print_failures(n, fixable, fails, changed, args.top))
    print(f"\n{'case':20} {'failed':>7}" + "".join(f"{c[:6]:>9}" for c, _ in CAUSES) + "   (% of the fixable)")
    for n, (fixable, summary) in table.items():
        failed = sum(summary.values())
        print(f"{n:20} {100.0 * failed / max(1, fixable):6.1f}%"
              + "".join(f"{100.0 * summary[c] / max(1, fixable):8.1f}%" for c, _ in CAUSES))
    print(f"(dumps in {out_dir})")
    return 0


def cmd_check(args, cfg):
    global args_quiet
    args_quiet = True
    if cmd_lint(args, cfg) != 0:
        sys.exit("pf check: lint failed")
    if cmd_test(args, cfg) != 0:
        sys.exit("pf check: tests failed")
    # The last run with the engine's own settings (not an experiment).
    before = [r for r in stored_runs(cfg) if not r[1].get("params")]
    args.only = None
    args.param = None
    _, record = run_suite(args, cfg)
    if not before:
        print("pf check: first stored run, nothing to compare with")
        return 0
    worse = compare(before[-1][1], record, args.tolerance)
    if worse:
        print(f"pf check: {len(worse)} number(s) worse by more than {args.tolerance} points", file=sys.stderr)
        return 1
    print("pf check: nothing worse")
    return 0


def cmd_rpm(args, cfg):
    spec = os.path.join(REPO, "rpm/parrotfish-keyboard.spec")
    if args.version:
        with open(spec) as f:
            text = f.read()
        text = re.sub(r"^(Version:\s*)\S+", lambda m: m.group(1) + args.version, text, count=1, flags=re.M)
        with open(spec, "w") as f:
            f.write(text)
    version = spec_version()
    target = setting(cfg, "sfdk", "target", "SailfishOS-5.1.0.11-aarch64")
    log = os.path.join(REPO, args.build, "sfdk-build.log")
    os.makedirs(os.path.dirname(log), exist_ok=True)
    # The dictionaries are the same files on any machine: built here (a
    # minute) instead of in the SDK's build engine (most of the RPM's
    # time), and copied by the RPM's build if their inputs match
    # (data/CMakeLists.txt: prebuilt/). --from-source: build them there.
    prebuilt = os.path.join(REPO, "prebuilt")
    shutil.rmtree(prebuilt, ignore_errors=True)
    if not args.from_source:
        build(args.build)
        data = os.path.join(REPO, args.build, "data")
        os.makedirs(prebuilt)
        for name in os.listdir(data):
            if name.endswith(".pfd") or name == "inputs.sha256":
                shutil.copy(os.path.join(data, name), prebuilt)
    # sfdk forgets the target between commands: set it in the same shell.
    # no-fix-version: the spec's Version, not one made from the latest git tag.
    try:
        with open(log, "w") as f:
            code = run(["sh", "-c", f"sfdk config target={target} && sfdk -c no-fix-version build"], stdout=f,
                       stderr=subprocess.STDOUT).returncode
    finally:
        shutil.rmtree(prebuilt, ignore_errors=True)
    rpms = [n for n in os.listdir(os.path.join(REPO, "RPMS")) if f"-{version}-" in n and n.endswith(".rpm")] \
        if os.path.isdir(os.path.join(REPO, "RPMS")) else []
    if code != 0 or not rpms:
        sys.exit(f"pf rpm: no RPM for {version} (log: {log})")
    # The main package and the experimental languages' one.
    paths = [os.path.join(REPO, "RPMS", n) for n in sorted(rpms)]
    for rpm in paths:
        print(rpm)
    dest = setting(cfg, "paths", "rpm_copy")
    if dest and not args.no_copy:
        if not os.path.isdir(dest):
            sys.exit(f"pf rpm: {dest} isn't there (not mounted?); the RPMs stay in RPMS/")
        for rpm in paths:
            shutil.copy(rpm, dest)
        print(f"copied to {dest}")
    return 0


