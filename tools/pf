"""pf: the developer front door of Parrotfish.

  tools/pf lint                  QML/JS traps for the phone's Qt 5.6
  tools/pf test                  build, then the unit and QML tests (ctest)
  tools/pf bench NAME ARGS...    run build/tests/NAME-bench (sentence, nextword...)
  tools/pf suite [--label L] [--param NAME=VALUE]...
                                 the standard benchmark suite; results stored
  tools/pf runs                  stored suite runs
  tools/pf compare [A [B]]       two runs side by side (default: the last two)
  tools/pf table [LABEL]         a stored run's main numbers, one line per language
  tools/pf sweep NAME "V1 V2..." [--quick N] [--best K] [--score EXPR]
                                 two stages: all values on the first N texts of
                                 each case, then the best K on the whole suite
  tools/pf diff A B [CASES]      the words whose outcome (fixed, wrong, left; kept,
                                 changed) differs between two runs, per case
  tools/pf failures [CASES] [--run LABEL] [--param NAME=VALUE]...
                                 the typos and misspellings not fixed, sorted by
                                 cause, per case (sentence-bench -C dumps)
  tools/pf check                 lint, test, suite, compare with the last run
                                 (without --param):
                                 exit 1 if a number got worse beyond --tolerance
  tools/pf rpm [--version V]     phone RPM with sfdk, copied where configured
               [--from-source]   (dictionaries built on this PC unless --from-source)
  tools/pf config                the settings in use

Settings that belong to one machine live outside the repo, in
~/.config/parrotfish-dev.ini (or $PF_CONFIG):

  [paths]
  results = ~/.local/share/parrotfish-dev/results
  rpm_copy = ~/some/folder          ; where `pf rpm` copies the RPM (optional)
  [sfdk]
  target = SailfishOS-5.1.0.11-aarch64
  [eval]
  ; more next-word test texts, one message per line: NAME = LANG:PATH
  ; mine-en = en:~/texts/messages-en.txt
  [misspellings]
  ; lists of real misspellings (misspelling TAB correct per line) for the
  ; suite's missp-NAME cases: NAME = LANG:PATH
  ; en = en:~/lists/en.dev.tsv

The suite's results stay in the results folder, never in the repo.
"""
import argparse
import concurrent.futures
import configparser
import datetime
import gzip
import hashlib
import json
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PHONE_LAYOUT = "data/layouts/phone-qwerty.layout"

# Metrics: True if higher is better, False if lower is better, None: neither.
DIRECTION = {
    "fixed": True, "wrong": False, "correct_changed": False, "unknown_changed": False,
    "wer_after": False, "missp_fixed": True, "missp_wrong": False, "missp_left": None,
    "missp_acc_fixed": True, "missp_acc_wrong": False, "missp_acc_left": None, "top1": True, "top3": True, "ksr": True, "unknown": None,
}


def config():
    path = os.path.expanduser(os.environ.get("PF_CONFIG", "~/.config/parrotfish-dev.ini"))
    cfg = configparser.ConfigParser()
    cfg.read(path)
    return path, cfg


def setting(cfg, section, key, default=None):
    value = cfg.get(section, key, fallback=default)
    return os.path.expanduser(value) if value else value


def run(cmd, **kw):
    return subprocess.run(cmd, cwd=kw.pop("cwd", REPO), **kw)


def build(build_dir):
    if run(["cmake", "--build", build_dir]).returncode != 0:
        sys.exit("pf: the build failed")


def git(*args):
    out = run(["git"] + list(args), capture_output=True, text=True)
    return out.stdout.strip()


def spec_version():
    with open(os.path.join(REPO, "rpm/parrotfish-keyboard.spec")) as f:
        m = re.search(r"^Version:\s*(\S+)", f.read(), re.M)
    return m.group(1) if m else "unknown"


# --- the suite -----------------------------------------------------------

def parse_summary(text, setting=None):
    """The metrics of a bench's `summary:` line (`summary[SETTING]:` for a
    -Y setting), in %."""
    start = f"summary[{setting}]:" if setting else "summary:"
    line = next((l for l in text.splitlines() if l.startswith(start)), "")
    m = {}
    if "typos fixed" in line:
        pats = {"fixed": r"typos fixed ([\d.]+)%", "wrong": r"wrong ([\d.]+)%",
                "correct_changed": r"correct changed ([\d.]+)%",
                "unknown_changed": r"unknown changed ([\d.]+)%", "wer_after": r"-> ([\d.]+)%"}
    else:
        pats = {"top1": r"next word top1 ([\d.]+)%", "top3": r"next word top1 [\d.]+% top3 ([\d.]+)%",
                "ksr": r"KSR ([\d.]+)%", "unknown": r"unknown ([\d.]+)%"}
    if "misspellings fixed" in line:
        pats.update({"missp_fixed": r"misspellings fixed ([\d.]+)%", "missp_wrong": r"misspellings fixed [\d.]+% wrong ([\d.]+)%",
                     "missp_left": r"misspellings fixed [\d.]+% wrong [\d.]+% left ([\d.]+)%",
                     "missp_acc_fixed": r"accents only fixed ([\d.]+)%",
                     "missp_acc_wrong": r"accents only fixed [\d.]+% wrong ([\d.]+)%",
                     "missp_acc_left": r"accents only fixed [\d.]+% wrong [\d.]+% left ([\d.]+)%"})
    for k, p in pats.items():
        f = re.search(p, line)
        if f:
            m[k] = float(f.group(1))
    return m


# The 13 typing languages, and the texts of each (pt serves pt_BR and pt_PT).
LANGUAGES = ["en", "it", "de", "fr", "es", "pt_BR", "pt_PT", "nl", "sv", "da", "nb", "fi", "ro"]


def language_group(lang, first=False):
    """The dictionaries loaded with `lang` in the suite: a typical set of
    typing languages; in the group's order, or `lang` first. The order
    matters (the typos use the first dictionary's letters): the cases of
    alpha88 keep theirs."""
    for group in (["en", "it", "de"], ["fr", "es", "en"]):
        if lang in group:
            return [lang] + [l for l in group if l != lang] if first else group
    return [lang, "en"]


def layout_of(lang):
    """The keyboard the suite types `lang` on: QWERTY (ÅÖÄ) for the Nordic
    languages, else QWERTY (also for de and fr, as up to alpha88)."""
    return "data/layouts/phone-nordic.layout" if lang in ("sv", "da", "nb", "fi") else PHONE_LAYOUT


def text_of(src, lang):
    return f"tests/data/{src}-{lang.split('_')[0]}.txt"


def suite_cases(build_dir, cfg, tmp):
    """(name, command, metrics to keep or None for all)."""
    d = lambda langs: sum((["-d", f"{build_dir}/data/{l}.pfd"] for l in langs), [])
    sentence = f"{build_dir}/tests/sentence-bench"
    nextword = f"{build_dir}/tests/nextword-bench"
    cases = []
    # Typos in running text: wrong keys, missing and extra letters, missing
    # spaces, the number row, uncertain taps, names mixed in.
    for lang in LANGUAGES:
        args = [sentence, "-l", layout_of(lang), "-t", text_of("tatoeba", lang)] + d(language_group(lang)) + \
               ["-m", lang, "-X", "-N", "75", "-T", "-K"]
        oov = os.path.join(REPO, "tests", "data", f"unknown-{lang}.txt")
        if os.path.exists(oov):
            args += ["-o", oov]
        cases.append((f"typos-{lang}", args, None))
    # Codes with a digit (mp3, ps4): left alone.
    cases.append(("codes-en", [sentence, "-l", PHONE_LAYOUT, "-t", "tests/data/tatoeba-en.txt"] +
                  d(["en", "it", "de"]) + ["-m", "en", "-N", "75", "-o", "tests/data/alnum.txt", "-u", "0.1"],
                  ["unknown_changed"]))
    # Words of another language in the text: left alone.
    for a, b in [("en", "it"), ("it", "en"), ("en", "de"), ("de", "en"), ("it", "de"), ("de", "it")]:
        for kind in ["insert", "switch"]:
            path = os.path.join(tmp, f"{kind}-{a}-{b}.txt")
            with open(path, "w") as f:
                run([sys.executable, "-I", "tools/eval/mix-sentences.py", kind, f"tests/data/tatoeba-{a}.txt",
                     f"tests/data/tatoeba-{b}.txt", "-n", "300", "-s", "1"], stdout=f, check=True)
            cases.append((f"mixed-{kind}-{a}-{b}", [sentence, "-l", PHONE_LAYOUT, "-t", path] +
                          d(["en", "it", "de"]) + ["-m", a, "-r", "0"], ["correct_changed"]))
    # ... and between English and each other language, with that language's
    # group loaded.
    for lang in LANGUAGES[3:]:
        for a, b in [(lang, "en"), ("en", lang)]:
            for kind in ["insert", "switch"]:
                path = os.path.join(tmp, f"{kind}-{a}-{b}.txt")
                with open(path, "w") as f:
                    run([sys.executable, "-I", "tools/eval/mix-sentences.py", kind, text_of("tatoeba", a),
                         text_of("tatoeba", b), "-n", "300", "-s", "1"], stdout=f, check=True)
                cases.append((f"mixed-{kind}-{a}-{b}", [sentence, "-l", layout_of(lang), "-t", path] +
                              d(language_group(lang)) + ["-m", a, "-r", "0"], ["correct_changed"]))
    # Real misspellings (recieve, propio) from lists of this machine
    # ([misspellings] in the settings), in running text: no other typos.
    if cfg.has_section("misspellings"):
        for name, value in cfg.items("misspellings"):
            lang, _, path = value.partition(":")
            lang, path = lang.strip(), os.path.expanduser(path.strip())
            langs = language_group(lang, first=True)
            text = text_of("sentences", lang)
            if os.path.exists(path) and os.path.exists(os.path.join(REPO, text)) \
                    and all(os.path.exists(f"{build_dir}/data/{l}.pfd") for l in langs):
                cases.append((f"missp-{name}", [sentence, "-l", layout_of(lang), "-t", text] + d(langs) +
                              ["-m", lang, "-N", "75", "-r", "0", "-W", path],
                              ["missp_fixed", "missp_wrong", "missp_left", "missp_acc_fixed", "missp_acc_wrong",
                               "missp_acc_left", "correct_changed"]))
    # Next words and keystrokes saved.
    for lang in LANGUAGES:
        for src in ["tatoeba", "sentences"]:
            cases.append((f"nextword-{src}-{lang}", [nextword, "-l", layout_of(lang), "-t", text_of(src, lang)]
                          + d(language_group(lang)) + ["-m", lang], None))
    # More test texts of this machine ([eval] in the settings).
    if cfg.has_section("eval"):
        for name, value in cfg.items("eval"):
            lang, _, path = value.partition(":")
            path = os.path.expanduser(path.strip())
            langs = [lang] + [l for l in ["en", "it", "de"] if l != lang][:2]
            if os.path.exists(path) and os.path.exists(f"{build_dir}/data/{lang}.pfd"):
                cases.append((f"nextword-{name}", [nextword, "-l", PHONE_LAYOUT, "-t", path] + d(langs)
                              + ["-m", lang], None))
    return cases


def run_case(case):
    """Runs one bench command: (name, metrics, seconds)."""
    name, cmd, keep = case
    t0 = time.monotonic()
    out = run(cmd, capture_output=True, text=True)
    seconds = time.monotonic() - t0
    if out.returncode != 0:
        return name, {"error": out.stderr.strip()[-300:]}, seconds
    m = parse_summary(out.stdout)
    if keep:
        m = {k: v for k, v in m.items() if k in keep}
    return name, m, seconds


def results_dir(cfg):
    path = setting(cfg, "paths", "results", "~/.local/share/parrotfish-dev/results")
    os.makedirs(path, exist_ok=True)
    return path


_file_hashes = {}


def file_hash(path):
    st = os.stat(path)
    key = (path, st.st_size, st.st_mtime_ns)
    if key not in _file_hashes:
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for block in iter(lambda: f.read(1 << 20), b""):
                h.update(block)
        _file_hashes[key] = h.hexdigest()
    return _file_hashes[key]


def fingerprint(cmd, tmp):
    """What a case's numbers depend on: its command (temporary paths left
    out) and the contents of every file it names: the bench (with the
    engine, linked in), dictionaries, layout, texts, lists."""
    h = hashlib.sha256()
    for arg in cmd:
        path = arg if os.path.isabs(arg) else os.path.join(REPO, arg)
        h.update((arg.replace(tmp, "<tmp>") if tmp else arg).encode() + b"\0")
        if os.path.isfile(path):
            h.update(file_hash(path).encode())
    return h.hexdigest()[:16]


def text_count(cmd):
    """The texts (lines) a sentence- or nextword-bench command types: those
    of its -t file, at most -n (2000)."""
    path, limit = None, 2000
    for i, a in enumerate(cmd[:-1]):
        if a == "-t":
            path = cmd[i + 1]
        elif a == "-n":
            limit = int(cmd[i + 1])
    if not path:
        return 0
    path = path if os.path.isabs(path) else os.path.join(REPO, path)
    with open(path, encoding="utf-8") as f:
        n = sum(1 for line in f if line.strip() and not line.startswith("#"))
    return min(n, limit)


def shard_jobs(name, cmd, shards):
    """The commands of a case split into `shards` ranges of its texts."""
    n = text_count(cmd)
    if shards <= 1 or n < 2 * shards or "-A" in cmd or "-n" in cmd:
        return [(name, 0, cmd)]
    bounds = [n * i // shards for i in range(shards + 1)]
    return [(name, i, cmd + ["-k", str(bounds[i]), "-n", str(bounds[i + 1]), "-Z"]) for i in range(shards)]


def run_job(job):
    """One shard (or a whole case): (name, shard, stdout or None, error, seconds)."""
    name, shard, cmd = job
    t0 = time.monotonic()
    out = run(cmd, capture_output=True, text=True)
    seconds = time.monotonic() - t0
    if out.returncode != 0:
        return name, shard, None, out.stderr.strip()[-300:], seconds
    return name, shard, out.stdout, "", seconds


def run_suite(args, cfg, label=None, store=True):
    """Runs the suite (args: param, only, replay, all, jobs, no_shard,
    texts) and stores a record per setting: the run, and one per --replay
    setting (label[SETTINGS]). Cases whose fingerprint matches a stored run
    are copied from it unless --all (or --replay)."""
    build(args.build)
    replay = list(getattr(args, "replay", None) or [])
    texts = getattr(args, "texts", None)
    dirty = bool(git("status", "--porcelain", "--untracked-files=no"))
    label = label or args.label or spec_version() + ("+dirty" if dirty else "")
    stamp = datetime.datetime.now().isoformat(timespec="seconds")
    base_name = f"{stamp.replace(':', '')}-{re.sub(r'[^A-Za-z0-9.~+_-]', '_', label)}"
    words_dir = os.path.join(results_dir(cfg), base_name + ".words")
    runs = stored_runs(cfg)
    with tempfile.TemporaryDirectory() as tmp:
        cases = suite_cases(args.build, cfg, tmp)
        params = sum((["-P", p] for p in args.param or []), [])
        cases = [(n, cmd + params + (["-n", str(texts)] if texts else []), keep) for n, cmd, keep in cases]
        if args.only:
            cases = [c for c in cases if re.search(args.only, c[0])]
        prints = {n: fingerprint(cmd, tmp) for n, cmd, _ in cases}
        # Reuse: the newest stored run with the same fingerprint for a case.
        reused, metrics, seconds = {}, {}, {}
        if not getattr(args, "all", False) and not replay:
            for n, _, _ in cases:
                for file, rec in reversed(runs):
                    if rec.get("fingerprints", {}).get(n) == prints[n] and "error" not in rec["cases"].get(n, {"error": 1}):
                        reused[n] = rec.get("reused", {}).get(n, file)   # the run that ran it
                        metrics[n] = rec["cases"][n]
                        seconds[n] = rec.get("timing", {}).get("cases", {}).get(n, 0)
                        break
        todo = [c for c in cases if c[0] not in reused]
        # Longest first (by the last run's times; new cases before all), so
        # that the cores stay busy to the end; cases longer than an even
        # share of the work are split by texts (same numbers: -k, -J).
        last = next((r["timing"]["cases"] for _, r in reversed(runs) if r.get("timing")), {})
        total = sum(last.get(n, 0) for n, _, _ in todo)
        share = max(3.0, total / max(1, args.jobs))
        os.makedirs(words_dir, exist_ok=True)
        jobs = []
        for n, cmd, _ in todo:
            extra = sum((["-Y", r] for r in replay), [])
            if "sentence-bench" in cmd[0]:
                extra += ["-O", os.path.join(words_dir, n + ".{shard}.tsv")]
            k = 1 if getattr(args, "no_shard", False) else min(16, math.ceil(last.get(n, 0) / share))
            for name, shard, c in shard_jobs(n, cmd + extra, k):
                jobs.append((name, shard, [a.replace("{shard}", str(shard)) for a in c]))
        jobs.sort(key=lambda j: -last.get(j[0], float("inf")) / max(1, sum(1 for x in jobs if x[0] == j[0])))
        cpu0, t0 = os.times(), time.monotonic()
        with concurrent.futures.ThreadPoolExecutor(args.jobs) as pool:
            done = list(pool.map(run_job, jobs))
        cpu1 = os.times()
        # Shards joined (the bench adds their counts up), metrics per setting.
        keys = {n: keep for n, _, keep in cases}
        cmd0 = {n: cmd[0] for n, cmd, _ in cases}
        variants = {r: {} for r in replay}
        for n, _, _ in todo:
            parts = sorted((d for d in done if d[0] == n), key=lambda d: d[1])
            seconds[n] = sum(d[4] for d in parts)
            error = next((d[3] for d in parts if d[2] is None), None)
            if error is not None:
                metrics[n] = {"error": error}
                continue
            text = "".join(d[2] for d in parts)
            if len(parts) > 1:
                text = run([cmd0[n], "-J"], input=text, capture_output=True, text=True).stdout
            keep = keys[n]
            pick = lambda m: {k: v for k, v in m.items() if not keep or k in keep}
            metrics[n] = pick(parse_summary(text))
            for r in replay:
                variants[r][n] = pick(parse_summary(text, r))
            # The words' outcomes, shards in order, one file per setting.
            outs = [os.path.join(words_dir, f"{n}.{d[1]}.tsv") for d in parts]
            if all(os.path.exists(o) for o in outs):
                lines = []
                for o in outs:
                    with open(o, encoding="utf-8") as f:
                        lines += f.readlines()
                    os.remove(o)
                for v in range(len(replay) + 1):
                    sub = os.path.join(results_dir(cfg), (base_name if v == 0 else f"{base_name}-r{v}") + ".words")
                    os.makedirs(sub, exist_ok=True)
                    with gzip.open(os.path.join(sub, n + ".tsv.gz"), "wt", encoding="utf-8") as f:
                        f.writelines(l.split("\t", 1)[1] for l in lines if l.split("\t", 1)[0] == str(v))
        timing = {"wall": round(time.monotonic() - t0, 2),
                  "cpu": round(cpu1.children_user + cpu1.children_system - cpu0.children_user - cpu0.children_system, 2),
                  "cases": {n: round(t, 2) for n, t in seconds.items()}}
    if os.path.isdir(words_dir) and not os.listdir(words_dir):
        os.rmdir(words_dir)
    records = []
    for v, r in enumerate([None] + replay):
        rec_label = label if r is None else f"{label}[{r}]"
        record = {"label": rec_label, "commit": git("rev-parse", "--short", "HEAD"), "dirty": dirty,
                  "params": (args.param or []) + (r.split(",") if r else []), "date": stamp,
                  "cases": metrics if r is None else variants[r], "timing": timing,
                  "fingerprints": prints if r is None else {}, "reused": reused if r is None else {},
                  "texts": texts}
        if r is not None:
            record["replayed"] = r
        path = os.path.join(results_dir(cfg), (base_name if v == 0 else f"{base_name}-r{v}") + ".json")
        if store:
            with open(path, "w") as f:
                json.dump(record, f, indent=1, sort_keys=True)
        records.append((path, record))
    errors = [n for n, m in metrics.items() if "error" in m]
    for n in errors:
        print(f"pf: {n} failed: {metrics[n]['error']}", file=sys.stderr)
    for path, record in records:
        print(f"stored {path} ({len(record['cases'])} cases" + (f", {len(reused)} reused" if reused and path == records[0][0] else "")
              + f"; wall {timing['wall']:.1f} s, CPU {timing['cpu']:.1f} s)")
    return records[0][0], records[0][1]


# --- comparing runs ----------------------------------------------------------

def stored_runs(cfg):
    folder = results_dir(cfg)
    runs = []
    for name in sorted(os.listdir(folder)):
        if name.endswith(".json"):
            with open(os.path.join(folder, name)) as f:
                runs.append((name, json.load(f)))
    return runs


def find_run(runs, key):
    """The newest run whose label or file name is `key`."""
    for name, rec in reversed(runs):
        if key in (rec["label"], name, name[:-5]):
            return rec
    sys.exit(f"pf: no stored run {key!r} (pf runs lists them)")


def compare(a, b, tolerance):
    """Prints the cases side by side; returns the regressions."""
    worse = []
    print(f"{'case':28} {'metric':16} {a['label'][:14]:>14} {b['label'][:14]:>14} {'change':>8}")
    missing = {"a": 0, "b": 0}
    for case in sorted(set(a["cases"]) | set(b["cases"])):
        ma, mb = a["cases"].get(case), b["cases"].get(case)
        # A case only one run has (a partial run, --only) or that failed:
        # shown, not left out.
        if ma is None or mb is None or "error" in ma or "error" in mb:
            def state(m):
                return "missing" if m is None else "error" if "error" in m else "ok"
            sa, sb = state(ma), state(mb)
            missing["a" if sa != "ok" else "b"] += 1
            print(f"{case:28} {'(case)':16} {sa:>14} {sb:>14}")
            continue
        for metric in sorted(set(ma) | set(mb)):
            if metric == "error":
                continue
            va, vb = ma.get(metric), mb.get(metric)
            if va is None or vb is None:
                print(f"{case:28} {metric:16} {str(va):>14} {str(vb):>14}")
                continue
            delta = vb - va
            better = DIRECTION.get(metric)
            flag = ""
            if better is not None and abs(delta) > 1e-9:
                gained = delta > 0 if better else delta < 0
                flag = "  better" if gained else "  WORSE"
                if not gained and abs(delta) > tolerance:
                    worse.append((case, metric, va, vb))
            if abs(delta) > 1e-9 or not args_quiet:
                print(f"{case:28} {metric:16} {va:14.2f} {vb:14.2f} {delta:+8.2f}{flag}")
    if missing["a"] or missing["b"]:
        print(f"cases missing or failed: {missing['a']} in {a['label']}, {missing['b']} in {b['label']}")
    return worse


args_quiet = False


# --- commands ----------------------------------------------------------------

def cmd_lint(args, cfg):
    return run(["tools/qt56-scan.sh", REPO]).returncode


def cmd_test(args, cfg):
    build(args.build)
    return run(["ctest", "--output-on-failure"], cwd=os.path.join(REPO, args.build)).returncode


def cmd_bench(args, cfg):
    exe = os.path.join(REPO, args.build, "tests", f"{args.name}-bench")
    if not os.path.exists(exe):
        sys.exit(f"pf: no {exe} (pf test builds it)")
    return run([exe] + args.args).returncode


def cmd_suite(args, cfg):
    path, record = run_suite(args, cfg)
    for case, m in sorted(record["cases"].items()):
        print(f"{case:28} " + "  ".join(f"{k} {v:.2f}" for k, v in sorted(m.items()) if k != "error"))
    return 0


